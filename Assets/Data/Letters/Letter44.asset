  m_Script: {fileID: 11500000, guid: 0eeb945c88124c10989ad86d225d13c2, type: 3}
  m_Name: Letter44
  m_EditorClassIdentifier: 
  sender: {fileID: 11400000, guid: 1ecef972dcb04e64fac03dc0709271b0, type: 2}
  receiver: {fileID: 11400000, guid: 1b4ad3d6af63b274ea5d29b40ebdcab0, type: 2}
  dependencies:
  - {fileID: 11400000, guid: a8adea44a830db146a1a25687b2fa8ba, type: 2}
  senderName: Martin
  text: "Bonjour,\r\nAvec grand plaisir, Val\xE9rie, tu peux venir jeter un coup
    d\u2019\u0153il \xE0 mon incroyable prise ! Tu ne verras pas un tr\xE9sor aussi
    beau de toute ta vie ailleurs ! Si tu n\u2019es pas press\xE9 par le temps, je
    compte exhiber ma prise lors de la F\xEAte des Couleurs, nous pourrons en discuter
    \xE0 ce moment-l\xE0 !\r\nEn tout cas, je suis fascin\xE9 ! C\u2019est incroyable
    que tu aies pu prendre connaissance de ma prise avant tout le monde ! Il faut
    absolument que tu m\u2019apprennes comment d\xE9velopper cet instinct ! Je suis
    s\xFBr qu\u2019avec, je pourrais p\xEAcher des tr\xE9sors par milliers !\r\nA
    bient\xF4t,\r\nMartin\r\n"
  sendedText:
  - "Vite, il faut que je lui donne une r\xE9ponse ! Tu veux bien la lui apporter
    ? Merci, facteur !"
  receivedText:
  - "Une r\xE9ponse ? Au moins, il ne m\u2019aura pas fait attendre, m\xEAme si je
    connais d\xE9j\xE0 la r\xE9ponse\u2026"
  - "\u2026"
  - "Je dois dire\u2026 Que je ne m\u2019attendais pas \xE0 \xE7a\u2026"
  - "Je crois que c\u2019est la premi\xE8re fois que cela m\u2019arrive\u2026 Un
    animal qui a h\xE2te de l\u2019arriv\xE9e du fisc\u2026"
  - "\u2026"
  - "Excellent ! Je sens une potentielle recrue ! J\u2019ai d\xE9cid\xE9 !"
  - "Je vais lui faire une fleur et lui laisser jusqu\u2019\xE0 la F\xEAte des Couleurs
    avant d\u2019inspecter son tr\xE9sor !"
  glansGain: 0
  stampGain: 0
  appearingCharacter: {fileID: 0}
  disappearingCharacter: {fileID: 0}
