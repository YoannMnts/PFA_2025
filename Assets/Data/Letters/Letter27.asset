  m_Script: {fileID: 11500000, guid: 0eeb945c88124c10989ad86d225d13c2, type: 3}
  m_Name: Letter27
  m_EditorClassIdentifier: 
  sender: {fileID: 11400000, guid: 8f7f29cef723b4440b99490ea59509f9, type: 2}
  receiver: {fileID: 11400000, guid: 1a080252247be3b4a87fed0f00c2172c, type: 2}
  dependencies:
  - {fileID: 11400000, guid: d9a28b0a4e0ddd045b41d3d0aee7b6cc, type: 2}
  senderName: Poutre
  text: "Bonjour <color=#D70000><b>Fr\xE9d\xE9ric</b></color>,,\r\nJe t\u2019\xE9cris
    car il y a du nouveau pour la <b>pr\xE9paration des festivit\xE9s</b>. Notre
    violoniste, <color=#D70000><b>Lucina</b></color>,, a maintenant son nouveau violon.
    Il ne lui reste plus qu\u2019\xE0 le tester et \xE0 le mettre au point pour le
    jour de la F\xEAte. J\u2019attends donc des nouvelles de leur part tr\xE8s prochainement.
    En revanche, je n\u2019ai toujours pas de nouvelles concernant les <b>stocks
    de nourriture </b>pour <color=#D70000><b>Larry</b></color>,. Sans cela, nous
    risquons de ne pas avoir assez pour tout le monde. Et bien que d\xE9licieux,
    ce ne sont pas les g\xE2teaux d\u2019<color=#D70000><b>Elise qui nous rassasieront.\r\nJe
    te mets au courant rapidement\r\nRespectueusement,\r\nPoutre.\r\n"
  sendedText:
  - "Oui ? C\u2019est pourquoi ?"
  - "Rien n\u2019a chang\xE9 ici ! J\u2019ai toujours trop de travail !"
  - "Me reposer ? J\u2019ai trop de travail pour me reposer ! Tu te rends compte
    de ce que je dois g\xE9rer ?"
  - "Moi non plus ! Mais c\u2019est \xE9norme !"
  - AAAAAAAAAAAH !
  - Mais ne nous affolons pas. Tout va bien se passer.
  - "Et pour que tout se passe bien, d\xE9livre cette lettre \xE0 <color=#D70000><b>Fr\xE9d\xE9ric</b></color>,
    je te prie"
  receivedText:
  - "Hmm\u2026"
  - "AAAAAH ! Sapristi ! \xC7a te tuerait de juste pr\xE9venir quand tu es l\xE0
    ?!"
  - "Tu m\u2019as fait une peur bleue !"
  - "Tu m\u2019apportes du courrier ? \u2026"
  - "Ce n\u2019est pas une raison pour faire sursauter les honn\xEAtes gens ! Les
    jeunes, je vous jure !"
  - "Bon\u2026 Assez tergivers\xE9. Voyons ce que <color=#D70000><b>Poutre m\u2019annonce
    de nouveau"
  - "\u2026"
  glansGain: 3
  stampGain: 1
  appearingCharacter: {fileID: 0}
  disappearingCharacter: {fileID: 0}
