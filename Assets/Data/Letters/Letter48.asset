  m_Script: {fileID: 11500000, guid: 0eeb945c88124c10989ad86d225d13c2, type: 3}
  m_Name: Letter48
  m_EditorClassIdentifier: 
  sender: {fileID: 11400000, guid: 5c6e884f0beeccc4889768905bf01ea3, type: 2}
  receiver: {fileID: 11400000, guid: ed1c784f61a160d49b72a96823946ba0, type: 2}
  dependencies:
  - {fileID: 11400000, guid: ed4039af06327e746bfb2bdd9d5b30f1, type: 2}
  senderName: Anotnin
  text: "Bonjour, <color=#D70000><b>Jack,\r\nJe n\u2019ai malheureusement pas de
    temps \xE0 perdre en \xE9locution et autre formulation, tu me pardonneras donc
    d\u2019aller droit au but. La <b>biblioth\xE8que </b>de <color=#D70000><b>Flora
    a de <b>gros probl\xE8mes </b>! Elle a trouv\xE9 dans sa collection de livres
    des <b>mangeurs d\u2019encres </b>! Si l\u2019on ne fait rien rapidement, la
    <b>Crise des Pages Blanches </b>se r\xE9p\xE9tera et nous perdrons tous les livres
    de Verd\u2019Oyant en plus de ceux que Flora a mis tant d\u2019effort \xE0 r\xE9cup\xE9rer.\r\nBien
    que trop tard, par le pass\xE9, ce fut ton grand-p\xE8re qui a d\xE9couvert ces
    petites chenilles blanches. Il avait r\xE9ussi \xE0 mettre au point un moyen
    de nous en d\xE9barrasser. Tu dois donc sans doute savoir comment le faire aussi
    ! D\xE8s que tu as ma lettre, rejoint-moi imm\xE9diatement chez <color=#D70000><b>Flora
    !\r\nAvec pression et gratitude,\r\n<color=#D70000><b>Antonin\r\n"
  sendedText:
  - "Facteur, le temps presse. Tu dois te d\xE9p\xEAcher et livrer cette <b>lettre
    </b>\xE0 Jack ! La petite <color=#D70000><b>Flora a des ennuis et je dois agir
    !"
  - "Je suis son parrain apr\xE8s tout !"
  receivedText:
  - "Oh ! mon petiot ! Comment tu vas ? \xC7a fait un moment que t\u2019es pas venu
    me voir ! Le travail se passe bien ?"
  - "Tu m\u2019apportes une <b>lettre </b>? <color=#D70000><b>D\u2019Antonin ?"
  - "Curieux\u2026 Il n\u2019a pourtant pas l'habitude de m'envoyer du courrier\u2026"
  - "\u2026 !"
  - "Sacr\xE9 nom de nom ! Petiot ! Le temps presse ! Il faut que je te laisse !
    Je dois vite rentrer chez moi pour <b>prendre mes affaires </b>!"
  - Bonne chance pour le reste de ton travail, petiot !
  glansGain: 4
  stampGain: 1
  appearingCharacter: {fileID: 0}
  disappearingCharacter: {fileID: 0}
