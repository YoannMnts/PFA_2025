  m_Script: {fileID: 11500000, guid: 0eeb945c88124c10989ad86d225d13c2, type: 3}
  m_Name: Letter24
  m_EditorClassIdentifier: 
  sender: {fileID: 11400000, guid: a8e02d414e45cc34a93975248246175f, type: 2}
  receiver: {fileID: 11400000, guid: ac853fc7cde38634b826552d02fa0800, type: 2}
  dependencies:
  - {fileID: 11400000, guid: 61087d274a00fe041a0c1cb6a0a24b56, type: 2}
  senderName: Capitaine Hans
  text: "J\u2019ai le regret de t\u2019annoncer que tu es dor\xE9navant en <b>\xE9tat
    d\u2019arrestation </b>! Des nouvelles me sont parvenues et visiblement tu n\u2019as
    pas tenu compte de ma mise en garde. Et il semblerait qu\u2019avoir utilis\xE9
    des feux d\u2019artifices l\u2019ann\xE9e derni\xE8re ne t\u2019a pas servi de
    le\xE7on !\r\nDois-je te rappeler, que les utiliser comme moyen d\u2019\xE9lan
    pour voler a failli non seulement te transformer en Steak de Tortue mais aussi
    mettre feu au village, ruinant la <b>F\xEAte des Couleurs</b>.\r\nRespectueusement,\r\n<color=#D70000><b>Capitaine
    Hans</b></color>.\r\n"
  sendedText:
  - "Soldat ! Il faut neutraliser le soldat <color=#D70000><b>Icare</b></color> !
    Prends cette <b>lettre </b>et apporte-la-lui de ce pas ! Il a d\xE9j\xE0 \xE9t\xE9
    averti, maintenant il est temps de s\xE9vir !"
  receivedText:
  - "Te revoil\xE0 ! Allez ! Donne-moi la lettre de <color=#D70000><b>Fr\xE9d\xE9ric</b></color>
    !"
  - "Mais ?! Cette lettre n\u2019est pas de <color=#D70000><b>Fr\xE9d\xE9ric ! Elle
    est du <color=#D70000><b>Capitaine Hans</b></color> !"
  - "Non ! Non ! \xC7a ne peut pas se terminer comme \xE7a ! Trahison ! Disgr\xE2ce
    !"
  glansGain: 2
  stampGain: 1
  appearingCharacter: {fileID: 0}
  disappearingCharacter: {fileID: 11400000, guid: ac853fc7cde38634b826552d02fa0800, type: 2}
