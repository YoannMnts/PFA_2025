  m_Name: 
  m_EditorClassIdentifier: 
  clips: []
  pnjData: {fileID: 11400000, guid: a2eaac1a1fac8c447b333e410c5ab2f7, type: 2}
  baseLines:
  - "<b>Bienvenue, cher invite</b> ! Puissiez-vous passer un <b>agreable s\xE9jour</b>
    au manoir  "
  - "Puis-je vous offrir quelque chose ?  Un digestif peut-\xEAtre ? Nous avons <b>quantite
    de breuvages qualitatifs</b> dans notre cave "
  - "Vous devez \xEAtre <b>epuise apres tout ce remue m\xE9nage</b> ! Vous \xEAtes
    le <b>bienvenue</b> dans une de nos chambres si vous souhaitez vous reposer"
  - "Mon maitre <b>attend sur la terrasse</b>. C\u2019est la raison de votre visite,
    n\u2019est ce pas ? "
  portrait: {fileID: 1614466794060287551, guid: 1ee8ec17722377a43b9d602565db0caa, type: 3}
  popUp: {fileID: 2011163901035035786}
  linesLeft: []
