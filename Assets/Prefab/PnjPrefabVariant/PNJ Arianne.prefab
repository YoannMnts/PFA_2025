  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7eca65b9c300357468b5fcae2d1074ee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  clips: []
  pnjData: {fileID: 11400000, guid: c333ba6243c47e64dac784babe641bbc, type: 2}
  baseLines:
  - "Ohohohoho ! Contemple donc <b>la grande, l\u2019unique</b>\u2026 MOI ! <b>o\xF9
    est <color=#D70000>Arianne Parpin</b></color> !"
  - "Je ne sais pas comment tu <b>m\u2019as trouvee</b> mais cela ne veut pas dire
    que tu <b>m\u2019attraperas</b>, jeune ecureuil. Ohohohoho ! Tu n\u2019es simplement
    <b>pas assez bon</b> !"
  - "C\u2019est toujours un regal de voir <b>la tete du <color=#D70000>Captain Hans</b></color>
    apres avoir r\xE9ussi a echapper a son <b>piege minutieusement pr\xE9par\xE9</b>"
  - Que pourrais etre <b>mon prochain coup</b> ?... Ohohohoho ! Dans tous les cas,
    j'obtiendrais <b>ce que je convoite</b>, comme toujours !
  portrait: {fileID: 1614466794060287551, guid: 1ee8ec17722377a43b9d602565db0caa, type: 3}
  popUp: {fileID: 448671930567782291}
  linesLeft: []
