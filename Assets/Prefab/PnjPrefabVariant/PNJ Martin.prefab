  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7eca65b9c300357468b5fcae2d1074ee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  clips: []
  pnjData: {fileID: 11400000, guid: 1ecef972dcb04e64fac03dc0709271b0, type: 2}
  baseLines:
  - "Un jour, je remonterais un <b>vrai tresor</b> ! Mais on dirait que <b>la chance
    ne me sourit pas</b> aujourd\u2019hui "
  - "La rivi\xE8re est <b>pleine d\u2019or, de bijoux et de pierres precieuses</b>,
    plus que tu ne pourrais en rever ! C\u2019est le courant qui les amene depuis
    <la capitale</b> "
  - "Regarde cette <b>boucle d\u2019oreille</b> que j\u2019ai trouvee au <b>bout
    de ma ligne</b> l\u2019autre jour ! Je n\u2019en suis pas peu fiere"
  - "Ah, le <b>son calme</b> de la riviere, tellement <b>relaxant</b>\u2026"
  portrait: {fileID: 1614466794060287551, guid: 1ee8ec17722377a43b9d602565db0caa, type: 3}
  popUp: {fileID: 147922038099780993}
  linesLeft: []
