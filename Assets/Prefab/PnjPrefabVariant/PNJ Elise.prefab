  clips: []
  pnjData: {fileID: 11400000, guid: ff1efd42a7eb34e44b2f88a9294420e2, type: 2}
  baseLines:
  - Tu veux <b>passer une commande</b> ?
  - <color=#D70000><b>Captain Hans</b></color> adore les patisseries. Il vient <b>tous
    les jours a la meme heure</b> pour commander des donuts
  - "<b>Je fais de la patisserie</b> depuis que je suis toute petite. Mes parents
    m\u2019ont toujours <b>complimente sur mes gateaux</b>."
  - "Tu sais, j\u2019ai <b>etudie et travaille en patisserie \xE0 Fau L\u2019Iaire</b>.
    Mes gateaux etaient <b>tres populaires</b> la-bas mais je pr\xE9f\xE8re ma vie
    ici"
  portrait: {fileID: 1614466794060287551, guid: 1ee8ec17722377a43b9d602565db0caa, type: 3}
  popUp: {fileID: 5059230852967557223}
  linesLeft: []
