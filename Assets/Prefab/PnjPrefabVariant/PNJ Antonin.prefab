  m_EditorClassIdentifier: 
  clips: []
  pnjData: {fileID: 11400000, guid: 5c6e884f0beeccc4889768905bf01ea3, type: 2}
  baseLines:
  - "En recherche d\u2019une maison cher monsieur ?"
  - "De penser qu\u2019il s\u2019est fait de nouveau avoir par ce tour, comme c\u2019est
    d\xE9licieux ! Hmm ? Oh ? Vous ici ?"
  - "N\u2019h\xE9sitez pas \xE0 me contacter au besoin. Votre humble serviteur, Antonin
    est \xE0 votre disposition"
  - "Si vous ne trouvez pas votre bonheur ici, allez voir Jack. Il vous construira
    tout ce que vous voulez. En plus de faire du bon travail, c\u2019est une bonne
    personne."
  portrait: {fileID: 1614466794060287551, guid: 1ee8ec17722377a43b9d602565db0caa, type: 3}
  popUp: {fileID: 6169560511969597717}
  linesLeft: []
