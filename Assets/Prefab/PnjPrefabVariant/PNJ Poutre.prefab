  m_Script: {fileID: 11500000, guid: 7eca65b9c300357468b5fcae2d1074ee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  clips: []
  pnjData: {fileID: 11400000, guid: 8f7f29cef723b4440b99490ea59509f9, type: 2}
  baseLines:
  - " \u2026 Je me demande comment se porte <b>ma s\u0153ur</b>\u2026"
  - "Je n\u2019ai <b>pas dormi</b> depuis des ann\xE9es"
  - Travail, travail, travail ! Il y a toujours <b>trop de travail</b> !
  - "Que me veux-tu ? Tu vas m\u2019assigner <b>encore plus de travail</b> ?"
  - "Tout le monde demande <b>o\xF9 est <color=#D70000>Poutre</b></color> mais jamais
    <b>comment va <color=#D70000>Poutre</b></color>\u2026"
  - "Ce que je fais comme travail? Je n\u2019ai <b>pas de sp\xE9cialit\xE9</b>. Pour
    la simple et bonne raison que <b>je peux tout faire</b>"
  portrait: {fileID: 1614466794060287551, guid: 1ee8ec17722377a43b9d602565db0caa, type: 3}
  popUp: {fileID: 5224948714225824222}
  linesLeft: []
