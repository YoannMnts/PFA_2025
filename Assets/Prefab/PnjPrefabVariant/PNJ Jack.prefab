  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7eca65b9c300357468b5fcae2d1074ee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  clips: []
  pnjData: {fileID: 11400000, guid: ed1c784f61a160d49b72a96823946ba0, type: 2}
  baseLines:
  - "Hei Ho ! Comment \xE7a va <b>mon petiot</b> ?!"
  - "T\u2019as besoin d\u2019un <b>truc \xE0 faire construire</b> ?! Je peux m\u2019en
    charger si tu veux !"
  - "<b>Vise l\u2019heure</b> mon petiot ! Hop ! Faut que je me <b>remette au travail</b>"
  - "C\u2019est moi qu\u2019ai <b>construit la totalit\xE9 du village</b> ! \u2018Fin
    c\u2019est ce que j\u2019aimerai dire. En r\xE9alit\xE9, \xE7a fait <b>des annees
    que ce bon tas de bois tient debout !</b> "
  - "<b>Mon arri\xE8re grand-pere</b> \xE9tait celui qui a construit <b>le chateau
    du legendaire roi, Leon II</b>"
  portrait: {fileID: 1614466794060287551, guid: 1ee8ec17722377a43b9d602565db0caa, type: 3}
  popUp: {fileID: 8390745553809792721}
  linesLeft: []
